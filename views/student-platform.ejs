<script>
  /* ============================================================
     1. استخراج معرف الطالب من الرابط
  ============================================================ */

  function getStudentIdFromPath() {

    const path = window.location.pathname;
    const parts = path.split('/');

    for (let i = 0; i < parts.length; i++) {

      if (
        parts[i] === 'studentsPlatform' &&
        i + 1 < parts.length
      ) {

        return parts[i + 1];

      }

    }

    console.warn(
      '⚠️ لم يتم العثور على معرف الطالب في الرابط، سيتم استخدام معرف افتراضي'
    );

    return '6a830ccd4edfef5becddacc0';
  }


  const STUDENT_ID = getStudentIdFromPath();


  /* ============================================================
     2. عناصر DOM
  ============================================================ */

  const paymentsWrapper =
    document.getElementById('paymentsWrapper');

  const lessonsContainer =
    document.getElementById('lessonsContainer');

  const totalPaymentsEl =
    document.getElementById('totalPayments');

  const paymentsSub =
    document.getElementById('paymentsSub');

  const totalLessonsEl =
    document.getElementById('totalLessons');

  const lessonsSub =
    document.getElementById('lessonsSub');

  const remainingAmountEl =
    document.getElementById('remainingAmount');

  const attendanceRateEl =
    document.getElementById('attendanceRate');

  const attendanceSub =
    document.getElementById('attendanceSub');

  const attendancePercent =
    document.getElementById('attendancePercent');

  const attendanceProgress =
    document.getElementById('attendanceProgress');

  const studentNameDisplay =
    document.getElementById('studentNameDisplay');

  const studentIdDisplay =
    document.getElementById('studentIdDisplay');

  const profileName =
    document.getElementById('profileName');

  const profileLevel =
    document.getElementById('profileLevel');

  const profileParent =
    document.getElementById('profileParent');

  const profilePhone =
    document.getElementById('profilePhone');

  const profileEmail =
    document.getElementById('profileEmail');

  const checkinBtn =
    document.getElementById('checkinBtn');

  const checkinStatus =
    document.getElementById('checkinStatus');

  const lastUpdate =
    document.getElementById('lastUpdate');

  const cardUidInput =
    document.getElementById('cardUidInput');

  const scanCardBtn =
    document.getElementById('scanCardBtn');


  /* ============================================================
     3. Helpers
  ============================================================ */

  function escapeHtml(value) {

    if (value === null || value === undefined) {
      return '';
    }

    return String(value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }


  function formatAmount(amount) {

    const value = Number(amount) || 0;

    return value.toLocaleString('ar-DZ');
  }


  function updateAttendanceUI(rate) {

    let numericRate = Number(rate) || 0;

    numericRate = Math.max(
      0,
      Math.min(100, numericRate)
    );

    const formattedRate =
      `${Math.round(numericRate)}%`;

    attendanceRateEl.textContent =
      formattedRate;

    attendancePercent.textContent =
      formattedRate;

    attendanceProgress.style.width =
      `${numericRate}%`;
  }


  /* ============================================================
     4. Render Payments
  ============================================================ */

  function renderPayments(payments) {

    if (
      !payments ||
      payments.length === 0
    ) {

      paymentsWrapper.innerHTML = `
        <div class="empty-state">

          <div class="empty-icon">
            🧾
          </div>

          لا توجد دفعات مسجلة حالياً

        </div>
      `;

      return;
    }


    const statusMap = {

      paid: {
        label: 'مدفوع',
        cls: 'badge-paid',
        icon: '✓'
      },

      pending: {
        label: 'معلق',
        cls: 'badge-pending',
        icon: '◷'
      },

      late: {
        label: 'متأخر',
        cls: 'badge-late',
        icon: '!'
      },

      cancelled: {
        label: 'ملغي',
        cls: 'badge-late',
        icon: '×'
      }

    };


    let html = '';


    payments.forEach((p) => {

      const status =
        statusMap[p.status] || {
          label: p.status || 'غير معروف',
          cls: 'badge-pending',
          icon: '•'
        };


      const amount =
        formatAmount(p.amount);


      const className =
        p.class?.name ||
        p.className ||
        '—';


      const month =
        p.month ||
        p.monthCode ||
        'غير محدد';


      html += `
        <div class="payment-item">

          <div class="payment-main">

            <div class="payment-icon">
              💳
            </div>

            <div class="payment-info">

              <div class="payment-month">
                ${escapeHtml(month)}
              </div>

              <div class="payment-class">
                ${escapeHtml(className)}
              </div>

            </div>

          </div>


          <div class="payment-side">

            <div class="payment-amount">
              ${amount} د.ج
            </div>

            <span class="badge ${status.cls}">
              ${status.icon}
              ${status.label}
            </span>

          </div>

        </div>
      `;

    });


    paymentsWrapper.innerHTML = html;
  }


  /* ============================================================
     5. Render Lessons
  ============================================================ */

  function renderLessons(lessons) {

    if (
      !lessons ||
      lessons.length === 0
    ) {

      lessonsContainer.innerHTML = `
        <div class="empty-state">

          <div class="empty-icon">
            📚
          </div>

          لا توجد حصص قادمة حالياً

        </div>
      `;

      return;
    }


    let html = '';


    lessons.forEach((l) => {

      const name =
        l.name ||
        l.className ||
        'حصة';


      const subject =
        l.subject ||
        '—';


      const teacher =
        l.teacher?.name ||
        l.teacherName ||
        '—';


      const schedule =
        l.schedule &&
        l.schedule.length > 0
          ? l.schedule[0]
          : null;


      const time =
        schedule?.time ||
        l.time ||
        '—';


      const day =
        schedule?.day ||
        l.day ||
        '—';


      const classroom =
        schedule?.classroom?.name ||
        l.classroom ||
        '—';


      html += `
        <div class="lesson-card">

          <div class="lesson-top">

            <div>

              <div class="lesson-name">
                ${escapeHtml(name)}
              </div>

              <div class="lesson-subject">
                ${escapeHtml(subject)}
              </div>

            </div>

            <span class="badge badge-active">
              ✓ قادمة
            </span>

          </div>


          <div class="lesson-meta">

            <span class="lesson-meta-item">

              <span class="icon">
                👨‍🏫
              </span>

              ${escapeHtml(teacher)}

            </span>


            <span class="lesson-meta-item">

              <span class="icon">
                🕒
              </span>

              ${escapeHtml(day)}
              ${escapeHtml(time)}

            </span>


            <span class="lesson-meta-item">

              <span class="icon">
                🚪
              </span>

              ${escapeHtml(classroom)}

            </span>

          </div>

        </div>
      `;

    });


    lessonsContainer.innerHTML = html;
  }


  /* ============================================================
     6. Update Statistics
  ============================================================ */

  function updateStats(
    payments,
    lessons
  ) {

    const total =
      payments?.length || 0;


    const paidCount =
      payments
        ? payments.filter(
            p => p.status === 'paid'
          ).length
        : 0;


    const pendingCount =
      payments
        ? payments.filter(
            p =>
              p.status === 'pending' ||
              p.status === 'late'
          ).length
        : 0;


    const totalAmount =
      payments
        ? payments.reduce(
            (sum, p) =>
              sum +
              (Number(p.amount) || 0),
            0
          )
        : 0;


    const paidAmount =
      payments
        ? payments
            .filter(
              p => p.status === 'paid'
            )
            .reduce(
              (sum, p) =>
                sum +
                (Number(p.amount) || 0),
              0
            )
        : 0;


    const remaining =
      Math.max(
        0,
        totalAmount - paidAmount
      );


    totalPaymentsEl.textContent =
      total;


    paymentsSub.textContent =
      `${paidCount} مدفوعة / ${pendingCount} معلقة`;


    totalLessonsEl.textContent =
      lessons?.length || 0;


    lessonsSub.textContent =
      lessons?.length
        ? `${lessons.length} هذا الأسبوع`
        : 'لا توجد حصص';


    remainingAmountEl.textContent =
      formatAmount(remaining);
  }


  /* ============================================================
     7. Update Profile
  ============================================================ */

  function updateProfile(student) {

    if (!student) {
      return;
    }


    const name =
      student.name ||
      'غير معروف';


    studentNameDisplay.textContent =
      name;


    studentIdDisplay.textContent =
      student.studentId ||
      student._id ||
      '—';


    profileName.textContent =
      name;


    profileLevel.textContent =
      student.academicYear ||
      student.level ||
      '—';


    profileParent.textContent =
      student.parentName ||
      '—';


    profilePhone.textContent =
      student.parentPhone ||
      student.phone ||
      '—';


    profileEmail.textContent =
      student.parentEmail ||
      student.email ||
      '—';
  }


  /* ============================================================
     8. Loading
  ============================================================ */

  function setLoading(loading) {

    if (!loading) {
      return;
    }


    paymentsWrapper.innerHTML = `
      <div class="loading">

        <div class="loading-icon"></div>

        جاري تحميل الدفعات...

      </div>
    `;


    lessonsContainer.innerHTML = `
      <div class="loading">

        <div class="loading-icon"></div>

        جاري تحميل الحصص...

      </div>
    `;
  }


  /* ============================================================
     9. Error
  ============================================================ */

  function showError(message) {

    const errorHtml = `
      <div class="error-box">

        <span>
          ⚠️
        </span>

        <span>
          ${escapeHtml(message)}
        </span>

      </div>
    `;


    paymentsWrapper.innerHTML =
      errorHtml;


    lessonsContainer.innerHTML =
      errorHtml;
  }


  /* ============================================================
     10. Fetch Student Data
  ============================================================ */

  async function fetchStudentData(
    studentId
  ) {

    setLoading(true);


    try {

      /* -----------------------------
         Student
      ----------------------------- */

      const studentRes =
        await fetch(
          `/api/students/${studentId}`
        );


      let student = null;


      if (studentRes.ok) {

        student =
          await studentRes.json();

      } else {

        console.warn(
          '⚠️ تعذر جلب بيانات الطالب'
        );

      }


      /* -----------------------------
         Lessons
      ----------------------------- */

      let lessons = [];


      const classesRes =
        await fetch(
          `/api/students/${studentId}/classes`
        );


      if (classesRes.ok) {

        const data =
          await classesRes.json();


        lessons =
          data.data ||
          data.classes ||
          data ||
          [];

      } else {

        console.warn(
          '⚠️ تعذر جلب الحصص'
        );

      }


      /* -----------------------------
         Payments
      ----------------------------- */

      let payments = [];


      const paymentsRes =
        await fetch(
          `/api/payments/student/${studentId}`
        );


      if (paymentsRes.ok) {

        const data =
          await paymentsRes.json();


        payments =
          data.payments ||
          data ||
          [];

      } else {

        console.warn(
          '⚠️ تعذر جلب الدفعات'
        );

      }


      /* -----------------------------
         Update Profile
      ----------------------------- */

      if (student) {

        updateProfile(student);


        if (
          student.attendanceRate !==
          undefined
        ) {

          updateAttendanceUI(
            student.attendanceRate
          );

        } else {

          const total =
            payments.length;


          const paid =
            payments.filter(
              p =>
                p.status === 'paid'
            ).length;


          const rate =
            total > 0
              ? Math.round(
                  (paid / total) * 100
                )
              : 0;


          updateAttendanceUI(rate);
        }

      } else {

        profileName.textContent =
          'لم يتم العثور على الطالب';


        updateAttendanceUI(0);
      }


      /* -----------------------------
         Render
      ----------------------------- */

      renderPayments(
        payments
      );


      renderLessons(
        lessons
      );


      updateStats(
        payments,
        lessons
      );


      /* -----------------------------
         Last Update
      ----------------------------- */

      lastUpdate.textContent =
        new Date().toLocaleString(
          'ar-DZ',
          {
            hour: '2-digit',
            minute: '2-digit'
          }
        );


      attendanceSub.textContent =
        'آخر 30 يوم';


      /* -----------------------------
         Check-in
      ----------------------------- */

      checkinBtn.disabled = false;

      checkinStatus.textContent =
        '✓ جاهز لتسجيل الحضور';

      checkinStatus.style.color =
        '#18a874';


    } catch (err) {

      console.error(
        '❌ خطأ في جلب البيانات:',
        err
      );


      showError(
        'حدث خطأ أثناء تحميل البيانات'
      );


      renderPayments([]);

      renderLessons([]);

      updateStats([], []);

      updateAttendanceUI(0);
    }
  }


  /* ============================================================
     11. Check-in
  ============================================================ */

  async function checkinStudent(
    cardUid = null
  ) {

    checkinBtn.disabled = true;


    checkinStatus.textContent =
      '⏳ جاري تسجيل الحضور...';


    checkinStatus.style.color =
      '#f59e0b';


    try {

      const body =
        cardUid
          ? { cardUid }
          : { studentId: STUDENT_ID };


      const res =
        await fetch(
          '/api/attendance/card-scan',
          {
            method: 'POST',

            headers: {
              'Content-Type':
                'application/json'
            },

            body:
              JSON.stringify(body)
          }
        );


      if (res.ok) {

        const result =
          await res.json();


        if (result.success) {

          checkinStatus.textContent =
            '✓ تم تسجيل حضورك بنجاح';


          checkinStatus.style.color =
            '#18a874';


          checkinBtn.innerHTML =
            '✓ تم التسجيل';


          setTimeout(() => {

            checkinBtn.innerHTML =
              '✓ تسجيل';

          }, 3000);


        } else {

          checkinStatus.textContent =
            `❌ ${
              result.error ||
              result.message ||
              'فشل التسجيل'
            }`;


          checkinStatus.style.color =
            '#ef5350';
        }


      } else {

        let errData = {};


        try {

          errData =
            await res.json();

        } catch (_) {

          errData = {};

        }


        checkinStatus.textContent =
          `❌ ${
            errData.error ||
            errData.message ||
            'حدث خطأ أثناء التسجيل'
          }`;


        checkinStatus.style.color =
          '#ef5350';
      }


    } catch (err) {

      console.error(
        '❌ خطأ في تسجيل الحضور:',
        err
      );


      checkinStatus.textContent =
        '❌ خطأ في الاتصال بالخادم';


      checkinStatus.style.color =
        '#ef5350';


    } finally {

      checkinBtn.disabled = false;

    }
  }


  /* ============================================================
     12. Check-in Button
  ============================================================ */

  checkinBtn.addEventListener(
    'click',
    () => {

      checkinStudent();

    }
  );


  /* ============================================================
     13. Card Scan
  ============================================================ */

  scanCardBtn.addEventListener(
    'click',
    () => {

      const uid =
        cardUidInput.value.trim();


      if (!uid) {

        checkinStatus.textContent =
          '⚠️ أدخل رقم البطاقة أولاً';


        checkinStatus.style.color =
          '#f59e0b';


        cardUidInput.focus();

        return;
      }


      checkinStudent(uid);


      cardUidInput.value = '';

    }
  );


  /* ============================================================
     14. Enter Key
  ============================================================ */

  cardUidInput.addEventListener(
    'keypress',
    (event) => {

      if (event.key === 'Enter') {

        scanCardBtn.click();

      }

    }
  );


  /* ============================================================
     15. Bottom Navigation
  ============================================================ */

  const navItems =
    document.querySelectorAll(
      '.nav-item'
    );


  navItems.forEach(
    (item) => {

      item.addEventListener(
        'click',
        () => {

          navItems.forEach(
            nav =>
              nav.classList.remove(
                'active'
              )
          );


          item.classList.add(
            'active'
          );


          const targetId =
            item.dataset.target;


          if (
            targetId &&
            targetId !== 'app'
          ) {

            const target =
              document.getElementById(
                targetId
              );


            if (target) {

              target.scrollIntoView({
                behavior: 'smooth',
                block: 'start'
              });

            }

          } else {

            window.scrollTo({
              top: 0,
              behavior: 'smooth'
            });

          }

        }
      );

    }
  );


  /* ============================================================
     16. Detect Scroll Section
  ============================================================ */

  const sections = [

    {
      id: 'app',
      nav: 0
    },

    {
      id: 'lessonsContainer',
      nav: 1
    },

    {
      id: 'paymentsWrapper',
      nav: 2
    },

    {
      id: 'profileName',
      nav: 3
    }

  ];


  window.addEventListener(
    'scroll',
    () => {

      const scrollPosition =
        window.scrollY + 180;


      let activeIndex = 0;


      sections.forEach(
        (section) => {

          const element =
            document.getElementById(
              section.id
            );


          if (!element) {
            return;
          }


          const top =
            element.getBoundingClientRect()
              .top +
            window.scrollY;


          if (
            scrollPosition >= top
          ) {

            activeIndex =
              section.nav;

          }

        }
      );


      navItems.forEach(
        (item, index) => {

          item.classList.toggle(
            'active',
            index === activeIndex
          );

        }
      );

    },
    {
      passive: true
    }
  );


  /* ============================================================
     17. Initial Load
  ============================================================ */

  fetchStudentData(
    STUDENT_ID
  );


  /* ============================================================
     18. Auto Refresh
  ============================================================ */

  setInterval(
    () => {

      fetchStudentData(
        STUDENT_ID
      );

    },
    60000
  );

</script>

</body>
</html>
