
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes"
  >

  <title>منصة الطالب | الرواد</title>

  <style>
    /* =========================================================
       ROOT
    ========================================================= */

    :root {
      --primary: #315bea;
      --primary-dark: #2345c7;
      --primary-light: #eef2ff;

      --secondary: #7357e8;
      --secondary-light: #f1edff;

      --success: #18a874;
      --success-light: #e8f8f1;

      --warning: #f59e0b;
      --warning-light: #fff7e5;

      --danger: #ef5350;
      --danger-light: #fff0f0;

      --text: #172033;
      --text-secondary: #647089;
      --text-muted: #8d98ab;

      --bg: #f5f7fc;
      --card: rgba(255, 255, 255, 0.92);
      --border: #e9edf5;

      --radius-sm: 12px;
      --radius-md: 18px;
      --radius-lg: 24px;
      --radius-xl: 30px;

      --shadow-sm: 0 4px 16px rgba(31, 45, 80, 0.05);
      --shadow-md: 0 10px 30px rgba(31, 45, 80, 0.08);
      --shadow-lg: 0 18px 50px rgba(31, 45, 80, 0.12);

      --transition: 0.25s ease;
    }


    /* =========================================================
       RESET
    ========================================================= */

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family:
        "Tajawal",
        "Segoe UI",
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        sans-serif;

      background:
        radial-gradient(
          circle at 10% 0%,
          rgba(49, 91, 234, 0.12),
          transparent 30%
        ),
        radial-gradient(
          circle at 100% 20%,
          rgba(115, 87, 232, 0.10),
          transparent 28%
        ),
        linear-gradient(145deg, #f7f9fd 0%, #eef2fa 100%);

      color: var(--text);
      min-height: 100vh;
      direction: rtl;
    }

    button,
    input {
      font-family: inherit;
    }

    button {
      border: none;
      outline: none;
    }


    /* =========================================================
       APP CONTAINER
    ========================================================= */

    .app-shell {
      width: 100%;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      padding: 0;
    }

    .platform {
      position: relative;
      width: 100%;
      max-width: 620px;
      min-height: 100vh;

      background:
        linear-gradient(
          180deg,
          rgba(255, 255, 255, 0.88),
          rgba(248, 250, 255, 0.96)
        );

      overflow: hidden;
    }


    /* =========================================================
       DECORATIVE BACKGROUND
    ========================================================= */

    .background-orb {
      position: absolute;
      border-radius: 50%;
      pointer-events: none;
      filter: blur(3px);
      opacity: 0.65;
    }

    .orb-one {
      width: 220px;
      height: 220px;
      top: -120px;
      right: -100px;
      background: rgba(49, 91, 234, 0.12);
    }

    .orb-two {
      width: 180px;
      height: 180px;
      top: 430px;
      left: -100px;
      background: rgba(115, 87, 232, 0.09);
    }


    /* =========================================================
       MAIN CONTENT
    ========================================================= */

    .content {
      position: relative;
      z-index: 2;
      padding: 18px 16px 110px;
    }


    /* =========================================================
       TOP HEADER
    ========================================================= */

    .top-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 20px;
    }

    .brand-area {
      display: flex;
      align-items: center;
      gap: 11px;
      min-width: 0;
    }

    .brand-icon {
      width: 48px;
      height: 48px;
      flex-shrink: 0;

      display: flex;
      align-items: center;
      justify-content: center;

      color: white;
      font-size: 22px;

      border-radius: 17px;

      background:
        linear-gradient(
          135deg,
          var(--primary),
          var(--secondary)
        );

      box-shadow:
        0 9px 22px rgba(49, 91, 234, 0.24);
    }

    .brand-text {
      min-width: 0;
    }

    .brand-text h1 {
      font-size: 19px;
      font-weight: 800;
      color: var(--text);
      line-height: 1.2;
      white-space: nowrap;
    }

    .brand-text p {
      margin-top: 4px;
      font-size: 11px;
      color: var(--text-muted);
      font-weight: 500;
    }

    .notification-btn {
      width: 43px;
      height: 43px;
      flex-shrink: 0;

      display: flex;
      align-items: center;
      justify-content: center;

      background: white;
      color: var(--text-secondary);

      border: 1px solid var(--border);
      border-radius: 15px;

      font-size: 17px;
      cursor: pointer;

      box-shadow: var(--shadow-sm);
      transition: var(--transition);
    }

    .notification-btn:active {
      transform: scale(0.94);
    }


    /* =========================================================
       WELCOME CARD
    ========================================================= */

    .welcome-card {
      position: relative;
      overflow: hidden;

      padding: 20px;
      margin-bottom: 18px;

      border-radius: 25px;

      background:
        linear-gradient(
          135deg,
          #315bea 0%,
          #4d61e9 45%,
          #7357e8 100%
        );

      color: white;

      box-shadow:
        0 18px 40px rgba(49, 91, 234, 0.22);
    }

    .welcome-card::before {
      content: "";
      position: absolute;
      width: 170px;
      height: 170px;
      border-radius: 50%;

      top: -100px;
      left: -70px;

      background: rgba(255, 255, 255, 0.09);
    }

    .welcome-card::after {
      content: "";
      position: absolute;
      width: 120px;
      height: 120px;
      border-radius: 50%;

      bottom: -80px;
      right: -40px;

      background: rgba(255, 255, 255, 0.08);
    }

    .welcome-content {
      position: relative;
      z-index: 2;
    }

    .welcome-label {
      font-size: 11px;
      opacity: 0.78;
      margin-bottom: 5px;
    }

    .welcome-name {
      font-size: 23px;
      font-weight: 800;
      margin-bottom: 13px;
    }

    .student-info-row {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 7px;
    }

    .student-chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;

      padding: 6px 10px;

      border-radius: 30px;

      background: rgba(255, 255, 255, 0.14);
      border: 1px solid rgba(255, 255, 255, 0.12);

      font-size: 11px;
      font-weight: 600;
    }


    /* =========================================================
       QUICK STATS
    ========================================================= */

    .stats-title {
      display: flex;
      align-items: center;
      justify-content: space-between;

      margin: 0 2px 11px;
    }

    .stats-title h2 {
      font-size: 15px;
      font-weight: 800;
    }

    .stats-title span {
      font-size: 10px;
      color: var(--text-muted);
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;

      margin-bottom: 23px;
    }

    .stat-card {
      position: relative;
      overflow: hidden;

      min-height: 115px;

      padding: 15px;

      background: var(--card);

      border: 1px solid rgba(226, 231, 241, 0.9);
      border-radius: 21px;

      box-shadow: var(--shadow-sm);

      transition: var(--transition);
    }

    .stat-card:active {
      transform: scale(0.985);
    }

    .stat-card::after {
      content: "";
      position: absolute;

      width: 70px;
      height: 70px;

      left: -25px;
      bottom: -30px;

      border-radius: 50%;

      background: rgba(49, 91, 234, 0.045);
    }

    .stat-top {
      display: flex;
      align-items: center;
      justify-content: space-between;

      margin-bottom: 8px;
    }

    .stat-icon {
      width: 34px;
      height: 34px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 11px;

      background: var(--primary-light);
      color: var(--primary);

      font-size: 15px;
    }

    .stat-card:nth-child(2) .stat-icon {
      color: var(--secondary);
      background: var(--secondary-light);
    }

    .stat-card:nth-child(3) .stat-icon {
      color: var(--warning);
      background: var(--warning-light);
    }

    .stat-card:nth-child(4) .stat-icon {
      color: var(--success);
      background: var(--success-light);
    }

    .stat-label {
      font-size: 11px;
      color: var(--text-secondary);
      font-weight: 600;
    }

    .stat-value {
      font-size: 22px;
      font-weight: 850;
      color: var(--text);
      line-height: 1.2;
    }

    .stat-sub {
      margin-top: 4px;
      color: var(--text-muted);
      font-size: 10px;
    }


    /* =========================================================
       SECTION HEADER
    ========================================================= */

    .section {
      margin-bottom: 22px;
    }

    .section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;

      margin-bottom: 11px;
      padding: 0 2px;
    }

    .section-title {
      display: flex;
      align-items: center;
      gap: 8px;

      font-size: 16px;
      font-weight: 800;
      color: var(--text);
    }

    .section-title-icon {
      width: 32px;
      height: 32px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 10px;

      background: var(--primary-light);
      color: var(--primary);

      font-size: 14px;
    }

    .section-action {
      font-size: 10px;
      color: var(--primary);
      font-weight: 700;
    }


    /* =========================================================
       PAYMENTS
    ========================================================= */

    .payments-card {
      overflow: hidden;

      background: white;

      border: 1px solid var(--border);
      border-radius: 22px;

      box-shadow: var(--shadow-sm);
    }

    .payment-item {
      padding: 14px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 10px;

      border-bottom: 1px solid #f0f2f7;
    }

    .payment-item:last-child {
      border-bottom: none;
    }

    .payment-main {
      min-width: 0;
      display: flex;
      align-items: center;
      gap: 11px;
    }

    .payment-icon {
      width: 40px;
      height: 40px;
      flex-shrink: 0;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 13px;

      background: #f5f7ff;
      color: var(--primary);

      font-size: 15px;
    }

    .payment-info {
      min-width: 0;
    }

    .payment-month {
      color: var(--text);
      font-size: 13px;
      font-weight: 800;

      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .payment-class {
      margin-top: 4px;

      color: var(--text-muted);
      font-size: 10px;

      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .payment-side {
      flex-shrink: 0;
      text-align: left;
    }

    .payment-amount {
      font-size: 12px;
      font-weight: 800;
      color: var(--text);
      white-space: nowrap;
      margin-bottom: 5px;
    }


    /* =========================================================
       BADGES
    ========================================================= */

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;

      padding: 5px 9px;

      border-radius: 30px;

      font-size: 9px;
      font-weight: 800;

      white-space: nowrap;
    }

    .badge-paid {
      color: #087a51;
      background: var(--success-light);
    }

    .badge-pending {
      color: #b36a00;
      background: var(--warning-light);
    }

    .badge-late {
      color: #bd3633;
      background: var(--danger-light);
    }

    .badge-active {
      color: #3154c5;
      background: var(--primary-light);
    }


    /* =========================================================
       LESSONS
    ========================================================= */

    .lessons-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .lesson-card {
      position: relative;
      overflow: hidden;

      padding: 15px;

      background: white;

      border: 1px solid var(--border);
      border-radius: 21px;

      box-shadow: var(--shadow-sm);

      transition: var(--transition);
    }

    .lesson-card:active {
      transform: scale(0.985);
    }

    .lesson-card::before {
      content: "";

      position: absolute;
      top: 0;
      bottom: 0;
      right: 0;

      width: 4px;

      background:
        linear-gradient(
          180deg,
          var(--primary),
          var(--secondary)
        );
    }

    .lesson-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;

      gap: 10px;
    }

    .lesson-name {
      font-size: 14px;
      font-weight: 800;
      color: var(--text);
    }

    .lesson-subject {
      color: var(--text-secondary);
      font-size: 10px;
      font-weight: 500;
      margin-top: 3px;
    }

    .lesson-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;

      margin-top: 12px;
    }

    .lesson-meta-item {
      display: inline-flex;
      align-items: center;
      gap: 5px;

      padding: 6px 8px;

      color: var(--text-secondary);
      background: #f7f8fc;

      border-radius: 9px;

      font-size: 9px;
      font-weight: 600;
    }

    .lesson-meta-item .icon {
      color: var(--primary);
    }


    /* =========================================================
       PROFILE
    ========================================================= */

    .profile-card {
      padding: 18px;

      background:
        linear-gradient(
          145deg,
          #ffffff,
          #f8faff
        );

      border: 1px solid var(--border);
      border-radius: 23px;

      box-shadow: var(--shadow-sm);
    }

    .profile-title {
      display: flex;
      align-items: center;
      gap: 10px;

      margin-bottom: 15px;
    }

    .profile-title-icon {
      width: 40px;
      height: 40px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 13px;

      background:
        linear-gradient(
          135deg,
          var(--primary-light),
          var(--secondary-light)
        );

      color: var(--primary);
      font-size: 17px;
    }

    .profile-title h3 {
      font-size: 15px;
      font-weight: 800;
    }

    .profile-title p {
      font-size: 10px;
      color: var(--text-muted);
      margin-top: 2px;
    }

    .profile-row {
      display: flex;
      align-items: center;
      justify-content: space-between;

      min-height: 44px;

      border-bottom: 1px dashed #e8ebf2;
      gap: 15px;
    }

    .profile-row:last-child {
      border-bottom: none;
    }

    .profile-label {
      color: var(--text-secondary);
      font-size: 11px;
      font-weight: 600;
    }

    .profile-value {
      max-width: 62%;

      color: var(--text);
      font-size: 11px;
      font-weight: 800;

      text-align: left;

      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }


    /* =========================================================
       CHECK IN
    ========================================================= */

    .checkin-box {
      margin-top: 16px;
      padding: 14px;

      background:
        linear-gradient(
          135deg,
          #eef3ff,
          #f5f0ff
        );

      border: 1px solid #e5e9ff;
      border-radius: 19px;
    }

    .checkin-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .checkin-title {
      display: flex;
      align-items: center;
      gap: 9px;

      font-size: 12px;
      font-weight: 800;
      color: #283e84;
    }

    .fingerprint {
      width: 34px;
      height: 34px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 11px;

      color: var(--primary);
      background: white;

      font-size: 16px;

      box-shadow: 0 4px 12px rgba(49, 91, 234, 0.08);
    }

    .btn-checkin {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;

      min-width: 90px;
      min-height: 38px;

      padding: 8px 15px;

      color: white;

      background:
        linear-gradient(
          135deg,
          var(--primary),
          var(--secondary)
        );

      border-radius: 12px;

      font-size: 11px;
      font-weight: 800;

      cursor: pointer;

      box-shadow:
        0 8px 18px rgba(49, 91, 234, 0.20);

      transition: var(--transition);
    }

    .btn-checkin:active {
      transform: scale(0.95);
    }

    .btn-checkin:disabled {
      opacity: 0.55;
      cursor: not-allowed;
      box-shadow: none;
    }

    .checkin-status {
      display: block;

      margin-top: 10px;

      font-size: 10px;
      font-weight: 700;
    }


    /* =========================================================
       CARD SCAN
    ========================================================= */

    .scan-area {
      margin-top: 12px;
    }

    .scan-label {
      display: block;

      margin-bottom: 7px;

      color: var(--text-secondary);
      font-size: 10px;
      font-weight: 700;
    }

    .scan-row {
      display: flex;
      gap: 7px;
    }

    .card-scan-input {
      min-width: 0;
      flex: 1;

      height: 42px;

      padding: 0 13px;

      color: var(--text);

      background: white;

      border: 1px solid #dfe4ee;
      border-radius: 13px;

      outline: none;

      direction: ltr;

      font-family: monospace;
      font-size: 12px;
      letter-spacing: 1px;

      transition: var(--transition);
    }

    .card-scan-input::placeholder {
      color: #aeb6c5;
    }

    .card-scan-input:focus {
      border-color: var(--primary);

      box-shadow:
        0 0 0 3px rgba(49, 91, 234, 0.08);
    }

    .scan-btn {
      flex-shrink: 0;

      height: 42px;

      padding: 0 15px;

      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;

      color: white;
      background: #202c45;

      border-radius: 13px;

      font-size: 10px;
      font-weight: 800;

      cursor: pointer;

      transition: var(--transition);
    }

    .scan-btn:active {
      transform: scale(0.95);
    }

    .scan-hint {
      display: flex;
      align-items: center;
      gap: 5px;

      margin-top: 7px;

      color: var(--text-muted);
      font-size: 9px;
    }


    /* =========================================================
       ATTENDANCE PROGRESS
    ========================================================= */

    .attendance-card {
      margin-top: 12px;
      padding: 14px;

      background: white;

      border: 1px solid var(--border);
      border-radius: 18px;
    }

    .attendance-head {
      display: flex;
      align-items: center;
      justify-content: space-between;

      margin-bottom: 9px;
    }

    .attendance-head span:first-child {
      color: var(--text-secondary);
      font-size: 10px;
      font-weight: 700;
    }

    .attendance-percent {
      color: var(--success);
      font-size: 13px;
      font-weight: 900;
    }

    .progress {
      height: 7px;

      overflow: hidden;

      background: #edf1f6;

      border-radius: 20px;
    }

    .progress-bar {
      width: 0%;
      height: 100%;

      border-radius: 20px;

      background:
        linear-gradient(
          90deg,
          #18a874,
          #40c994
        );

      transition: width 0.7s ease;
    }


    /* =========================================================
       EMPTY / LOADING / ERROR
    ========================================================= */

    .loading {
      min-height: 90px;

      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;

      gap: 9px;

      color: var(--text-muted);
      font-size: 11px;
    }

    .loading-icon {
      width: 28px;
      height: 28px;

      border: 3px solid #e8ecf4;
      border-top-color: var(--primary);

      border-radius: 50%;

      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    .empty-state {
      padding: 24px 15px;

      text-align: center;
      color: var(--text-muted);
      font-size: 11px;
    }

    .empty-icon {
      width: 42px;
      height: 42px;

      display: flex;
      align-items: center;
      justify-content: center;

      margin: 0 auto 9px;

      border-radius: 14px;

      color: #9ba6b9;
      background: #f4f6fa;

      font-size: 17px;
    }

    .error-box {
      margin-top: 10px;
      padding: 13px;

      display: flex;
      align-items: center;
      gap: 9px;

      color: #a63838;
      background: var(--danger-light);

      border: 1px solid #ffd8d8;
      border-radius: 14px;

      font-size: 11px;
      line-height: 1.6;
    }


    /* =========================================================
       FOOTER
    ========================================================= */

    .footer {
      margin-top: 22px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 10px;

      color: var(--text-muted);
      font-size: 9px;
    }

    .footer-item {
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .footer-item strong {
      color: var(--text-secondary);
    }


    /* =========================================================
       BOTTOM NAVIGATION
    ========================================================= */

    .bottom-nav {
      position: fixed;

      z-index: 100;

      bottom: 12px;
      right: 50%;

      transform: translateX(50%);

      width: calc(100% - 24px);
      max-width: 580px;

      height: 64px;

      display: flex;
      align-items: center;
      justify-content: space-around;

      padding: 6px;

      background:
        rgba(255, 255, 255, 0.91);

      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);

      border: 1px solid rgba(225, 230, 240, 0.9);
      border-radius: 21px;

      box-shadow:
        0 15px 40px rgba(31, 45, 80, 0.14);
    }

    .nav-item {
      position: relative;

      width: 25%;
      height: 52px;

      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;

      gap: 3px;

      color: #929bad;

      font-size: 9px;
      font-weight: 700;

      border-radius: 16px;

      cursor: pointer;

      transition: var(--transition);
    }

    .nav-item-icon {
      font-size: 17px;
      line-height: 1;
    }

    .nav-item.active {
      color: var(--primary);
      background: var(--primary-light);
    }

    .nav-item.active::after {
      content: "";

      position: absolute;

      width: 5px;
      height: 5px;

      bottom: 5px;

      border-radius: 50%;

      background: var(--primary);
    }


    /* =========================================================
       RESPONSIVE
    ========================================================= */

    @media (min-width: 600px) {

      body {
        padding: 30px 0;
      }

      .app-shell {
        align-items: flex-start;
      }

      .platform {
        min-height: auto;

        border-radius: 34px;

        box-shadow: var(--shadow-lg);
      }

      .content {
        padding: 25px 25px 110px;
      }

      .bottom-nav {
        bottom: 22px;
      }

      .stats-grid {
        grid-template-columns: repeat(4, 1fr);
      }

      .stat-card {
        min-height: 130px;
      }
    }


    /* =========================================================
       SMALL PHONES
    ========================================================= */

    @media (max-width: 360px) {

      .content {
        padding-left: 12px;
        padding-right: 12px;
      }

      .brand-icon {
        width: 43px;
        height: 43px;
        font-size: 19px;
      }

      .brand-text h1 {
        font-size: 17px;
      }

      .welcome-card {
        padding: 17px;
      }

      .welcome-name {
        font-size: 20px;
      }

      .stat-card {
        padding: 13px;
        min-height: 108px;
      }

      .stat-value {
        font-size: 20px;
      }

      .lesson-meta {
        gap: 5px;
      }

      .lesson-meta-item {
        font-size: 8px;
        padding: 5px 6px;
      }

      .profile-card {
        padding: 15px;
      }

      .bottom-nav {
        width: calc(100% - 16px);
        bottom: 8px;
      }
    }


    /* =========================================================
       SAFE AREA FOR MODERN PHONES
    ========================================================= */

    @supports (padding: max(0px)) {

      .content {
        padding-bottom:
          max(110px, calc(110px + env(safe-area-inset-bottom)));
      }

      .bottom-nav {
        bottom:
          max(10px, calc(10px + env(safe-area-inset-bottom)));
      }
    }
  </style>
</head>

